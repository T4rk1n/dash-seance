# Copy to .env and fill in. Without a key the spirit and the guests use canned lines.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# The spirit's voice: any model from https://openrouter.ai/models?output_modalities=speech
# and a voice that model knows. Without a key the browser's own voice is used.
OPENROUTER_TTS_MODEL=elevenlabs/eleven-v3
OPENROUTER_TTS_VOICE=Callum

# Seconds of silence before an AI guest asks the spirit a question.
# While a tab is open this keeps making LLM calls, so raise it to spend less.
SEANCE_IDLE=25
